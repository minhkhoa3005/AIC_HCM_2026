# Copy this file to .env for local development.
# This project uses local inference and does not require API keys.

# All text and vision-language inference runs locally.
LLM_PROVIDER=local
VLM_PROVIDER=local
LOCAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
LOCAL_DEVICE=cuda
# 4-bit is recommended for an NVIDIA GPU with 8 GB VRAM.
LOCAL_LOAD_IN_4BIT=true
VLM_LOCAL_BATCH_SIZE=8
VLM_LOCAL_MAX_NEW_TOKENS=192
LLM_LOCAL_MAX_NEW_TOKENS=1536
VLM_LOCAL_MIN_PIXELS=200704
VLM_LOCAL_MAX_PIXELS=401408
VLM_CANDIDATE_LIMIT=40
VLM_WEIGHT=0.65

LLM_REWRITE_TEMPERATURE=0
LLM_PLANNER_TEMPERATURE=0

# Optional real CLIP/FAISS retrieval bundle.
# Use an absolute path or a path relative to the process working directory.
AIC_ARTIFACT_DIR=video_search_bundle/clip-b32-btc-v1
AIC_CLIP_MODEL_NAME=ViT-B/32
AIC_DEVICE=cuda
# Must be true when artifact_manifest.json declares text_only_lora.
AIC_USE_LORA=true
# Optional. Required only when VLM is enabled and keyframes are outside this repo.
AIC_KEYFRAMES_ROOT=Keyframes
