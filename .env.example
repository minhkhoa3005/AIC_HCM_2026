# Project/data locations. Relative paths are resolved from the project root.
AIC_PROJECT_ROOT=.
AIC_DATA_ROOT=data
AIC_ZIP_DIR=ZIP
AIC_ARTIFACT_DIR=data/index/clip-b32-btc-v1

# CLIP/LoRA bundle contract
AIC_CLIP_MODEL_NAME=ViT-B/32
AIC_DEVICE=cuda
AIC_USE_LORA=false
LORA_RANK=4
LORA_ALPHA=1.0

# Optional transcription. The BTC task uses Vietnamese transcription.
AIC_WHISPER_MODEL_SIZE=base
AIC_WHISPER_DEVICE=cpu
AIC_WHISPER_COMPUTE_TYPE=int8
AIC_WHISPER_LANGUAGE=vi
AIC_WHISPER_TASK=transcribe

# Optional legacy remote vector database. Keep disabled for local FAISS delivery.
USE_REMOTE_VECTOR_DB=false
