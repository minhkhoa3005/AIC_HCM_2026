# Copy this file to .env for local development.
# Never commit real API keys.

# Current provider implementation is Gemini via google-genai.
LLM_PROVIDER=gemini
# Comma-separated keys. For one key, use: LLM_API_KEYS=your-key
LLM_API_KEYS=
LLM_MODEL=gemini-2.5-flash

LLM_REWRITE_TEMPERATURE=0
LLM_PLANNER_TEMPERATURE=0
